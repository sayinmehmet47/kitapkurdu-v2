# Cloudflare Workers static-asset headers.
# The EPUB reader frame renders untrusted book content with foliate-js, whose
# iframes need allow-scripts (WebKit bug 218086). This CSP is what keeps book
# scripts from running: only this app's own scripts may execute, and nothing
# may load from outside this origin. Blob documents inherit this policy.
/reader/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' blob: data:; font-src 'self' blob: data:; media-src blob:; connect-src 'self' blob:; frame-src 'self' blob:; child-src 'self' blob:; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/vendor/foliate-js/*
  X-Content-Type-Options: nosniff

# pdf.js decoders, CMaps and fonts (npm run vendor:pdfjs). Their paths are
# not versioned, so browsers revalidate (ETag, 304) instead of keeping a copy
# that a later deploy could not replace.
/vendor/pdfjs/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

# Mozilla's pdf.js viewer (npm run vendor:pdfjs-viewer). PDFs never run
# scripts (enableScripting is off); only this site's files may load.
/vendor/pdfjs-viewer/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
