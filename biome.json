{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**",
			"public/reader/**",
			"tests/**/*.ts",
			"scripts/**/*.mjs",
			"scripts/pdfjs-viewer/**",
			"playwright.config.ts",
			"playwright-mcp.config.json",
			"package.json",
			"biome.json",
			"drizzle.config.ts",
			"opencode.jsonc",
			"wrangler*.jsonc",
			"wrangler.e2e.json",
			"tsconfig.json",
			".vscode/**",
			"vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
