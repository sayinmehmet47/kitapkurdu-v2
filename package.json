{
	"name": "kitapkurdu-v2",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.13.0 <25"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"dev:e2e": "node scripts/e2e-server.mjs",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"build:test": "CLOUDFLARE_ENV=test vite build",
		"preview": "vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"check:write": "biome check --write",
		"test": "tsx --test tests/*.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"setup:browsers": "playwright install chromium && playwright-mcp install-browser chromium",
		"mcp:browser": "playwright-mcp --config playwright-mcp.config.json",
		"verify": "npm run check && npm run cf:typegen -- --check && npm run generate-routes && npm run typecheck && npm test && npm run build:test && npm run test:e2e",
		"typecheck": "tsc --noEmit",
		"cf:typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false",
		"deploy": "npm run build && wrangler deploy",
		"deploy:test": "npm run build:test && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
		"db:migrate:test": "wrangler d1 migrations apply DB --remote --env test --config wrangler.jsonc"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "5.3.0",
		"@fontsource-variable/newsreader": "5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.13",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-query-devtools": "5.104.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "^1.5.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dompurify": "3.4.17",
		"drizzle-orm": "^0.45.1",
		"fflate": "0.8.3",
		"lucide-react": "^0.577.0",
		"pdfjs-dist": "6.4.299",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"saxes": "6.0.0",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@playwright/mcp": "0.0.83",
		"@playwright/test": "1.64.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.5",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.9",
		"miniflare": "5.20261019.2-beta",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.70.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
